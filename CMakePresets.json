{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-mingw-release",
      "displayName": "Windows MinGW64 Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/windows-mingw-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "g++.exe",
        "VE_BUILD_DESKTOP": "ON",
        "VE_BUILD_TESTS": "ON"
      },
      "environment": {
        "PATH": "C:/msys64/mingw64/bin;$penv{PATH}"
      }
    },
    {
      "name": "dev",
      "displayName": "Local development",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "VE_BUILD_DESKTOP": "ON",
        "VE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-mingw-release", "configurePreset": "windows-mingw-release" },
    { "name": "dev", "configurePreset": "dev" }
  ],
  "testPresets": [
    { "name": "dev", "configurePreset": "dev", "output": { "outputOnFailure": true } }
  ]
}

